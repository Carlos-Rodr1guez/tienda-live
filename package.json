{
  "name": "tienda-live",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo de juegos interactivos para TikTok LIVE. Nombre provisorio hasta definir la marca.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "games/*",
    "packages/*"
