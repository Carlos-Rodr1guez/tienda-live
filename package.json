{
  "name": "tienda-live",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo de juegos interactivos para TikTok LIVE. Nombre provisorio hasta definir la marca.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "games/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w asedio-live --",
    "test": "npm test --workspaces --if-present && node --test scripts/check-licenses.test.mjs",
    "build:demo": "npm run build:demo -w asedio-live",
    "lint": "eslint . --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "licenses": "node scripts/check-licenses.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run licenses"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "3.10.1",
    "typescript": "^7.0.2"
  }
}
