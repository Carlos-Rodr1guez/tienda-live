---
// Portada provisoria: la portada real (póster, formulario, escalera de regalos) llega en el lote siguiente. Ya usa el
// diseño base para que tenga cabecera, pie con el aviso de no afiliación y metadatos.
import { BRAND } from '@tienda/contracts/brand';
import { fmt, inicio, sitio } from '@tienda/contracts/i18n';
import BaseLayout from '../layouts/BaseLayout.astro';

const titulo = fmt(sitio.tituloInicio, { marca: BRAND.name });
---

<BaseLayout title={titulo} description={sitio.descripcion} path="/">
  <section class="sec container apoyo">
    <h1>{inicio.titulo}</h1>
    <p>{sitio.descripcion}</p>
  </section>
</BaseLayout>
